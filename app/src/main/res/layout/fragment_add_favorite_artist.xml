<?xml version="1.0" encoding="utf-8"?>
<!--
    Formulario "Agregar a favoritos" (HU10, prototipo 10 Favorito). Arriba, el aviso de error
    (solo si falta el coleccionista) y la tarjeta del artista; luego el campo coleccionista y
    los botones Agregar y Cancelar.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addFavoriteScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.artists.favorite.AddFavoriteArtistFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Aviso de error: aparece al tocar el botón sin elegir coleccionista -->
        <LinearLayout
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_error_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error"
                app:tint="?attr/colorOnErrorContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/add_favorite_error_banner"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer" />
        </LinearLayout>

        <!-- Artista que se agrega a favoritos. Es un solo elemento para TalkBack:
             "Artista, nombre, tipo y cantidad de álbumes" -->
        <LinearLayout
            android:id="@+id/artistSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="@dimen/add_track_cover_size"
                android:layout_height="@dimen/add_track_cover_size"
                android:background="@drawable/bg_circle"
                android:backgroundTint="?attr/colorSurfaceContainerHighest"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_visitor"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_favorite_artist_label"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/artistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Rubén Blades" />

                <TextView
                    android:id="@+id/artistInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Músico · 3 álbumes" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_favorite_required_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Coleccionista (campo común de los formularios del coleccionista) -->
        <include
            android:id="@+id/collectorField"
            layout="@layout/include_collector_field" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/add_favorite_save"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="28dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/savingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="@string/add_favorite_saving"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/add_favorite_cancel"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
