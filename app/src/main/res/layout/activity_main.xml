<?xml version="1.0" encoding="utf-8"?>
<!--
    Actividad única de la app (prototipo: Header + Main + Nav - Secciones).
    Barra superior de 64dp: ícono del disco, título de la sección y chip del rol
    (al tocarlo se vuelve a elegir el rol). Barra inferior con las tres secciones.
    Las barras se ocultan en la selección de rol.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
            Fila de 64dp mínimo. El título y el chip van en un Flow: si no caben juntos (fuente grande),
            el chip baja a una segunda fila, alineado al inicio, y el título conserva todo el ancho
            para que ninguna palabra se parta. Con fuente normal se ve en una sola fila.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <!-- Disco en las secciones principales; flecha "volver" en las demás pantallas -->
            <!-- 48dp de área táctil (mínimo de accesibilidad); el ícono sigue midiendo 24dp -->
            <ImageView
                android:id="@+id/topBarIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_album"
                app:layout_constraintBottom_toBottomOf="@id/topBarTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/topBarTitle"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/topBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                app:layout_constrainedWidth="true"
                tools:ignore="UnusedAttribute"
                tools:text="@string/nav_albums" />

            <com.google.android.material.chip.Chip
                android:id="@+id/roleChip"
                style="@style/Widget.Vinilos.RoleChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/role_visitor" />

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:constraint_referenced_ids="topBarTitle,roleChip"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="8dp"
                app:flow_horizontalStyle="spread_inside"
                app:flow_verticalGap="0dp"
                app:flow_wrapMode="chain"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/topBarIcon"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="79dp"
            app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>
</LinearLayout>
