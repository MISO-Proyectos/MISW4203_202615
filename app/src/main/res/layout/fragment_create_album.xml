<?xml version="1.0" encoding="utf-8"?>
<!--
    Formulario "Agregar álbum" (HU07, prototipo "07 Crear álbum").
    Cada campo tiene su etiqueta arriba; la fecha se elige con un calendario y el género
    y el sello con listas desplegables. Los errores aparecen debajo de cada campo.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createAlbumScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.albums.create.CreateAlbumFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_album_required_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/nameLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/nameInput"
            android:text="@string/create_album_name_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLayout"
            style="@style/Widget.Vinilos.TextField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_album_name_placeholder"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- URL de la portada -->
        <TextView
            android:id="@+id/coverLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/coverInput"
            android:text="@string/create_album_cover_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/coverLayout"
            style="@style/Widget.Vinilos.TextField"
            app:helperText="@string/create_album_cover_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/coverInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_album_cover_placeholder"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de lanzamiento: no se escribe, se elige en el calendario -->
        <TextView
            android:id="@+id/releaseDateLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/releaseDateInput"
            android:text="@string/create_album_release_date_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/releaseDateLayout"
            style="@style/Widget.Vinilos.TextField"
            app:endIconContentDescription="@string/create_album_pick_date"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/releaseDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/create_album_release_date_placeholder"
                android:inputType="none"
                android:longClickable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Género -->
        <TextView
            android:id="@+id/genreLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/genreInput"
            android:text="@string/create_album_genre_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/genreLayout"
            style="@style/Widget.Vinilos.TextField.Dropdown"
            app:helperText="@string/create_album_genre_helper">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/genreInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_album_genre_placeholder"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sello discográfico -->
        <TextView
            android:id="@+id/recordLabelLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/recordLabelInput"
            android:text="@string/create_album_record_label_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/recordLabelLayout"
            style="@style/Widget.Vinilos.TextField.Dropdown"
            app:helperText="@string/create_album_record_label_helper">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/recordLabelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_album_record_label_placeholder"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción -->
        <TextView
            android:id="@+id/descriptionLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/descriptionInput"
            android:text="@string/create_album_description_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/descriptionLayout"
            style="@style/Widget.Vinilos.TextField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/create_album_description_placeholder"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/create_album_save"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="28dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/savingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/create_album_saving"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/create_album_cancel"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
