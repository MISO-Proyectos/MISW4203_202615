<?xml version="1.0" encoding="utf-8"?>
<!--
    Formulario "Agregar track" (HU08, prototipo "08 Track").
    Arriba, el aviso de error (solo si falta algo) y la tarjeta del álbum; luego los campos
    nombre y duración (MM:SS) y los botones Guardar y Cancelar.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addTrackScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.albums.tracks.AddTrackFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Aviso de error: aparece al tocar Guardar con campos incompletos -->
        <LinearLayout
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_error_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error"
                app:tint="?attr/colorOnErrorContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/add_track_error_banner"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer" />
        </LinearLayout>

        <!-- Álbum al que se agrega la canción -->
        <LinearLayout
            android:id="@+id/albumSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/albumCover"
                android:layout_width="@dimen/add_track_cover_size"
                android:layout_height="@dimen/add_track_cover_size"
                android:background="?attr/colorSurfaceContainerHighest"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Vinilos.AlbumCover"
                tools:src="@drawable/ic_album" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_track_album_label"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/albumName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Buscando América" />

                <TextView
                    android:id="@+id/albumInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Rubén Blades · 4 tracks" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_track_required_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Nombre del track -->
        <TextView
            android:id="@+id/trackNameLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/trackNameInput"
            android:text="@string/add_track_name_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/trackNameLayout"
            style="@style/Widget.Vinilos.TextField"
            app:endIconDrawable="@drawable/ic_music"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/trackNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_track_name_placeholder"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Duración -->
        <TextView
            android:id="@+id/trackDurationLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/trackDurationInput"
            android:text="@string/add_track_duration_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/trackDurationLayout"
            style="@style/Widget.Vinilos.TextField"
            app:helperText="@string/add_track_duration_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/trackDurationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789:"
                android:hint="@string/add_track_duration_placeholder"
                android:imeOptions="actionDone"
                android:inputType="time"
                android:maxLength="5"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveTrackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/add_track_save"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="28dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/savingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="@string/add_track_saving"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/add_track_cancel"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
