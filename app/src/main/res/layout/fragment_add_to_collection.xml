<?xml version="1.0" encoding="utf-8"?>
<!--
    Formulario "Agregar a colección" (HU11, prototipo hu11-album-coleccionista).
    Arriba, el aviso de error (solo si falta algo) y la tarjeta del álbum; luego los campos
    coleccionista, precio y estado (Activo o Inactivo) y los botones Agregar y Cancelar.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addToCollectionScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.albums.collection.AddToCollectionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Aviso de error: aparece al tocar el botón con campos incompletos -->
        <LinearLayout
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_error_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error"
                app:tint="?attr/colorOnErrorContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/add_to_collection_error_banner"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer" />
        </LinearLayout>

        <!-- Álbum que se agrega a la colección -->
        <LinearLayout
            android:id="@+id/albumSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/albumCover"
                android:layout_width="@dimen/add_track_cover_size"
                android:layout_height="@dimen/add_track_cover_size"
                android:background="?attr/colorSurfaceContainerHighest"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Vinilos.AlbumCover"
                tools:src="@drawable/ic_album" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_to_collection_album_label"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/albumName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Buscando América" />

                <TextView
                    android:id="@+id/albumInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Rubén Blades · 4 tracks" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_to_collection_required_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Coleccionista (campo común de los formularios del coleccionista) -->
        <include
            android:id="@+id/collectorField"
            layout="@layout/include_collector_field" />

        <!-- Precio -->
        <TextView
            android:id="@+id/priceLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/priceInput"
            android:text="@string/add_to_collection_price_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/priceLayout"
            style="@style/Widget.Vinilos.TextField"
            app:helperText="@string/add_to_collection_price_helper"
            app:prefixText="@string/add_to_collection_price_prefix">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/priceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_to_collection_price_placeholder"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="9"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Estado: el grupo no tiene error propio, por eso el error va en un TextView debajo -->
        <TextView
            android:id="@+id/statusLabel"
            style="@style/Widget.Vinilos.FormLabel"
            android:labelFor="@id/statusGroup"
            android:text="@string/add_to_collection_status_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/statusGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusActiveButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/add_to_collection_status_active" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusInactiveButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/add_to_collection_status_inactive" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/statusError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/add_to_collection_error_status"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/add_to_collection_status_helper"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/add_to_collection_save"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="28dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/savingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/add_to_collection_saving"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/add_to_collection_cancel"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
